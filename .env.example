# Benni OS Operator Gateway — Environment Variables

# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ────────────────────────────────────────────
# Gateway API key — clients must send this in Authorization: Bearer <key>
GATEWAY_API_KEY=your_gateway_api_key_here

# ── JARVAS-2 Connector ───────────────────────────────
# URL of your self-hosted JARVAS-2 instance
JARVAS2_BASE_URL=http://localhost:8000
JARVAS2_API_KEY=your_jarvas2_api_key_here

# ── GitHub Connector ────────────────────────────────
GITHUB_TOKEN=your_github_token_here

# ── Approval Gate ────────────────────────────────────
# Webhook URL to receive approval requests (Slack, Discord, custom)
APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
APPROVAL_TIMEOUT_MS=300000

# ── LLM Gateway (optional) ───────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
